APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://legal:legal@postgres:5432/legal_agents
DATABASE_URL_SYNC=postgresql://legal:legal@postgres:5432/legal_agents

ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

GOOGLE_PROJECT_ID=replace_me
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REFRESH_TOKEN=replace_me
GMAIL_MAILBOX_USER=me
GMAIL_DEFAULT_QUERY=in:inbox -category:promotions -category:social
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google_service_account.json
GOOGLE_WORKSPACE_IMPERSONATION_USER=

LEXISNEXIS_BASE_URL=https://api.lexisnexis.example
LEXISNEXIS_API_KEY=replace_me
LEXISNEXIS_CLIENT_ID=replace_me
LEXISNEXIS_CLIENT_SECRET=replace_me

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_this_to_a_long_random_value

POSTGRES_DB=legal_agents
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal

EMAIL_TRIAGE_USE_CLAUDE=false
EMAIL_TRIAGE_SAVE_DRAFT_STUB=true
EMAIL_TRIAGE_LABEL_PROCESSED=Processed
EMAIL_TRIAGE_LABEL_PENDING_REVIEW=Drafts Pending Review
EMAIL_TRIAGE_LABEL_MANUAL_REVIEW=NEEDS_MANUAL_REVIEW
EMAIL_TRIAGE_URGENT_THRESHOLD=8
